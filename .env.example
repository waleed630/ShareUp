# Local settings for start-all.ps1
# Copy this file to ".env" (same folder) and fill in the values.
# ".env" is in .gitignore and must never be committed.

# Must be identical for all three services
JWT_SECRET=

# auth-service (MySQL)
DATABASE_URL=jdbc:mysql://localhost:3306/shareup_auth
DB_USERNAME=
DB_PASSWORD=

# item-service / rental-service (MongoDB)
ITEM_MONGODB_URI=mongodb://localhost:27017/shareup_items
RENTAL_MONGODB_URI=mongodb://localhost:27017/shareup_rentals

# Cloudinary (item-service and rental-service)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail (rental-service) - dummy values are fine locally, mail failures are ignored
MAIL_USERNAME=dummy@example.com
MAIL_PASSWORD=dummy
